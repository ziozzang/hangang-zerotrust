                  ],
                  "pattern": "^[+-]?([0-9.]+)([eEinumkKMGTP]*[-+]?[0-9]*)$"
                },
                "memory": {
                  "type": [
                    "string",
                    "number"
                  ],
                  "pattern": "^[+-]?([0-9.]+)([eEinumkKMGTP]*[-+]?[0-9]*)$"
                },
                "ephemeral-storage": {
                  "type": [
                    "string",
                    "number"
                  ],
                  "pattern": "^[+-]?([0-9.]+)([eEinumkKMGTP]*[-+]?[0-9]*)$"
