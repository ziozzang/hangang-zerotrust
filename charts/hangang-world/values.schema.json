          "maxProperties": 64
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          },
          "maxProperties": 64
        },
        "tolerations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string",
          "maxLength": 253
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backend": {
              "enum": [
