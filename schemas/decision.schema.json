{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hangang.example.test/schemas/decision.schema.json",
  "$comment": "Draft server/control-plane contract. Successful parsing does not establish identity or authority.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "outcome": {
      "enum": [
        "allow",
        "deny",
        "challenge",
        "unavailable"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "resource_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "catalog": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "policy": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "identity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "network": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "authority_epoch",
        "catalog",
        "policy",
        "identity",
        "network"
      ]
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "application_object_authorization",
              "no_export",
              "no_sensitive_logging"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "request_id",
    "outcome",
    "reason_code",
    "resource_id",
    "action",
    "subject_ref",
    "revisions",
    "obligations",
    "valid_until"
  ]
}
