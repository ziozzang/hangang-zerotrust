{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hangang.example.test/schemas/event.schema.json",
  "$comment": "Draft server/control-plane contract. Successful parsing does not establish identity or authority.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "component": {
      "enum": [
        "hangang",
        "hopae",
        "guard",
        "catalog",
        "classifier",
        "exporter"
      ]
    },
    "instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "event_type": {
      "enum": [
        "decision",
        "network_signal",
        "admin_intent",
        "admin_outcome",
        "provider_failure",
        "policy_publish",
        "classification_proposal"
      ]
    },
    "outcome": {
      "enum": [
        "allow",
        "deny",
        "challenge",
        "unavailable",
        "pending",
        "succeeded",
        "failed",
        "uncertain"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "resource_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "catalog": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "policy": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "identity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "network": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "authority_epoch",
        "catalog",
        "policy",
        "identity",
        "network"
      ]
    },
    "latency_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "occurred_at",
    "observed_at",
    "component",
    "instance_id",
    "event_type",
    "outcome",
    "reason_code",
    "resource_id",
    "action",
    "request_id",
    "revisions",
    "latency_us"
  ]
}
