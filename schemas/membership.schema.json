{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hangang.example.test/schemas/membership.schema.json",
  "$comment": "Draft authenticated control-plane metadata. JSON validity does not verify signature, peer identity, readiness or freshness.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "domain": {
      "enum": [
        "hopae",
        "sumunjang",
        "pumgye"
      ]
    },
    "authority_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "authority_epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "minimum_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max_staleness_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 5000
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "nodes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "incarnation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "state": {
            "enum": [
              "joining",
              "ready",
              "draining",
              "removed"
            ]
          },
          "compiled_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "snapshot_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "endpoint": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string",
                "format": "hostname",
                "maxLength": 253
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "protocol": {
                "enum": [
                  "HOP1",
                  "HGD1",
                  "PPG1"
                ]
              },
              "mtls": {
                "const": true
              },
              "tls_server_name": {
                "type": "string",
                "format": "hostname",
                "maxLength": 253
              },
              "tls_service_identity": {
                "type": "string",
                "minLength": 10,
                "maxLength": 512,
                "pattern": "^spiffe://[A-Za-z0-9./_-]+$"
              }
            },
            "required": [
              "host",
              "port",
              "protocol",
              "mtls",
              "tls_server_name",
              "tls_service_identity"
            ]
          }
        },
        "required": [
          "node_id",
          "incarnation",
          "state",
          "compiled_revision",
          "snapshot_sha256",
          "capacity",
          "endpoint"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "domain",
    "authority_id",
    "authority_epoch",
    "generation",
    "minimum_revision",
    "max_staleness_ms",
    "valid_from",
    "valid_until",
    "nodes"
  ]
}
