{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hangang.example.test/schemas/projection_request.schema.json",
  "$comment": "Proposed structural contract only: requires separately authenticated receipts and native atomic replay/revocation checks. Contains no credentials or permit boolean.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "resource_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "plan_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "audience_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "authentication_receipt_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "issuance_nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "method": {
      "enum": [
        "GET",
        "HEAD",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS"
      ]
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "catalog": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "policy": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "identity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "network": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "authority_epoch",
        "catalog",
        "policy",
        "identity",
        "network"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    }
  },
  "required": [
    "request_id",
    "decision_id",
    "subject_ref",
    "service_id",
    "resource_id",
    "action",
    "plan_ref",
    "audience_ref",
    "authentication_receipt_ref",
    "issuance_nonce",
    "schema_version",
    "method",
    "request_digest",
    "revisions",
    "issued_at",
    "valid_until"
  ]
}
